# Multistage Dockerfile for a Vite static frontend served by a small Node BFF.
# The BFF serves the built static assets AND proxies /api to the INTERNAL backend
# (attaching a Google ID token for Cloud Run IAM auth — see webhooks-service.md
# and cloudrun-best-practices.md for the token pattern).
# Re-verify base image tags before building.
#
# This is the PUBLIC frontend (--ingress all). The backend stays internal; only
# the BFF talks to it, server-side, with an ID token. No secrets baked in.

# ---------- web builder (Vite static assets) ----------
FROM node:22-slim AS web-builder
WORKDIR /web
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# Emits static assets to /web/dist (Vite default).
RUN npm run build

# ---------- bff deps (production only) ----------
# Assumes the Node BFF server lives in ./server with its own package.json.
FROM node:22-slim AS bff-deps
WORKDIR /bff
COPY server/package.json server/package-lock.json* ./
RUN npm ci --omit=dev

# ---------- final ----------
# Distroless nodejs: no shell, no npm, runs as nonroot (UID 65532).
FROM gcr.io/distroless/nodejs22-debian12:nonroot
WORKDIR /app

ENV NODE_ENV=production \
    PORT=8080

# BFF server code + its production node_modules.
COPY --from=bff-deps /bff/node_modules ./node_modules
COPY server/ ./
# Built static assets the BFF will serve (e.g. from ./public).
COPY --from=web-builder /web/dist ./public

EXPOSE 8080

# Distroless nodejs entrypoint is `node`. The BFF must:
#   - serve ./public statically
#   - proxy /api/* to BACKEND_URL with an ID token (audience = BACKEND_URL)
#   - listen on 0.0.0.0:$PORT and expose /healthz
# BACKEND_URL is injected at runtime via Cloud Run env vars.
CMD ["index.js"]

# ----------------------------------------------------------------------------
